DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

PORT=
FRONTEND_URL=
NODE_ENV=

TELEMETRY_DB_HOST=
TELEMETRY_DB_PORT=
TELEMETRY_DB_USER=
TELEMETRY_DB_PASSWORD=
TELEMETRY_DB_NAME=

TELEMETRY_REDIS_URL=

TELEMETRY_REDIS_STREAM=
TELEMETRY_REDIS_GROUP=

TELEMETRY_WORKER_BATCH_SIZE=
TELEMETRY_WORKER_BLOCK_MS=
TELEMETRY_WORKER_CLAIM_IDLE_MS=
TELEMETRY_WORKER_RECOVERY_MS=

TELEMETRY_FLEET_API_KEY=
TELEMETRY_LATEST_HASH=
# Ingest fails fast with HTTP 503 + Retry-After while Redis reconnects.
TELEMETRY_REDIS_CONNECT_TIMEOUT_MS=1000

# HTTP listener tuning; validate these values with a production load test.
HTTP_LISTEN_BACKLOG=1024
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=66000

# Keep reset tokens out of production API responses. A secure mail/OTP delivery
# provider must be configured before enabling public password recovery.
NODE_ENV=production

# Redis Stream recovery window. Trimming occurs only after all delivered entries are ACKed.
TELEMETRY_STREAM_RETENTION_MS=21600000
TELEMETRY_STREAM_TRIM_INTERVAL_MS=60000
